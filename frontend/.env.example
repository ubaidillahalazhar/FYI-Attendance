# Laravel REST API URL
VITE_API_BASE_URL=/api

# Set to 'false' when Laravel + PostgreSQL backend is running
VITE_USE_MOCK=true

# Office Geofence Coordinates (Default: Bekasi / Cikarang Industrial Area)
# VITE_OFFICE_* only used in mock mode; API mode reads the office from backend .env
VITE_OFFICE_LAT=-6.3017
VITE_OFFICE_LNG=107.1705
VITE_OFFICE_RADIUS_METERS=150
