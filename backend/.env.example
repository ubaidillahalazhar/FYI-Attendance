APP_NAME="GeoAttend HR API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

# PostgreSQL Configuration
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=geoattend_hr
DB_USERNAME=postgres
DB_PASSWORD=postgres_password

# Office Geofencing Configuration
OFFICE_NAME="HQ Office — Corporate Tower"
OFFICE_LAT=-6.3017
OFFICE_LNG=107.1705
OFFICE_RADIUS_METERS=150
GEOFENCE_MAX_ACCURACY_METERS=100

# CORS Frontend Origin
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
